Panels:
- Class: rviz_common/Displays
  Help Height: 70
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /RobotModel1
    - /LaserScan1
    - /TF1
    Splitter Ratio: 0.5
  Tree Height: 400
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 20
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/Odometry
    Name: Robot (posición)
    Enabled: true
    Value: true
    Topic: /odom
    Unreliable: false
    Keep: 1
    Position Tolerance: 0.01
    Angle Tolerance: 0.01
    Covariance:
      Value: false
    Shape:
      Value: Arrow
      Color: 0; 220; 255
      Alpha: 1
      Shaft Length: 0.3
      Shaft Radius: 0.04
      Head Length: 0.12
      Head Radius: 0.09
  - Class: rviz_default_plugins/TF
    Enabled: false
    Filter (blacklist): ''
    Filter (whitelist): ''
    Frame Timeout: 15
    Frames:
      All Enabled: true
    Marker Scale: 0.25
    Name: TF
    Show Arrows: false
    Show Axes: true
    Show Names: true
    Tree: {}
    Update Interval: 0
    Value: false
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/LaserScan
    Color: 255; 0; 0
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Min Color: 0; 0; 0
    Name: LaserScan
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.019999999552965164
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /scan
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Class: rviz_default_plugins/Map
    Name: Mapa
    Enabled: true
    Value: true
    Topic:
      Value: /map
      Depth: 1
      History Policy: Keep Last
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Alpha: 0.8
    Color Scheme: map
    Draw Behind: true
  - Class: rviz_default_plugins/Map
    Name: Costmap global
    Enabled: false
    Value: false
    Topic:
      Value: /global_costmap/costmap
      Depth: 1
      History Policy: Keep Last
      Durability Policy: Volatile
      Reliability Policy: Reliable
    Alpha: 0.3
    Color Scheme: costmap
    Draw Behind: false
  - Class: rviz_default_plugins/Map
    Name: Costmap local
    Enabled: true
    Value: true
    Topic:
      Value: /local_costmap/costmap
      Depth: 1
      History Policy: Keep Last
      Durability Policy: Volatile
      Reliability Policy: Reliable
    Alpha: 0.4
    Color Scheme: costmap
    Draw Behind: false
  - Class: rviz_default_plugins/Map
    Name: Visto por la camara
    Enabled: true
    Value: true
    Topic:
      Value: /exploracion/visto
      Depth: 1
      History Policy: Keep Last
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Alpha: 0.45
    Color Scheme: costmap
    Draw Behind: false
  - Class: rviz_default_plugins/Path
    Name: Plan global
    Enabled: true
    Value: true
    Topic:
      Value: /plan
      Depth: 5
      History Policy: Keep Last
      Durability Policy: Volatile
      Reliability Policy: Reliable
    Color: 0; 170; 255
    Line Style: Lines
    Line Width: 0.03
  - Class: rviz_default_plugins/Path
    Name: Plan local
    Enabled: true
    Value: true
    Topic:
      Value: /local_plan
      Depth: 5
      History Policy: Keep Last
      Durability Policy: Volatile
      Reliability Policy: Reliable
    Color: 255; 200; 0
    Line Style: Lines
    Line Width: 0.03
  - Class: nav2_rviz_plugins/ParticleCloud
    Name: Particulas AMCL
    Enabled: true
    Value: true
    Topic:
      Value: /particle_cloud
      Depth: 5
      History Policy: Keep Last
      Durability Policy: Volatile
      Reliability Policy: Best Effort
  - Class: rviz_default_plugins/MarkerArray
    Name: Sectores BCD
    Enabled: true
    Value: true
    Topic:
      Value: /exploracion/sectores
      Depth: 5
      History Policy: Keep Last
      Durability Policy: Transient Local
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/MarkerArray
    Name: NBV (candidatos y goal)
    Enabled: true
    Value: true
    Namespaces: {}
    Topic:
      Value: /exploracion/marcadores
      Depth: 5
      History Policy: Keep Last
      Durability Policy: Volatile
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/MarkerArray
    Name: Victimas detectadas
    Enabled: true
    Value: true
    Namespaces: {}
    Topic:
      Value: /deteccion/marcadores
      Depth: 5
      History Policy: Keep Last
      Durability Policy: Volatile
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Image
    Name: Camara (apagada para no cargar la PC)
    Enabled: false
    Value: false
    Topic:
      Value: /cam_1/color/image_raw
      Depth: 1
      History Policy: Keep Last
      Durability Policy: Volatile
      Reliability Policy: Best Effort
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 15
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      Scale: 140
      X: 2.0
      Y: 1.5
      Angle: 0.0
    Saved: null
Window Geometry:
  Camera:
    collapsed: false
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Views:
    collapsed: false
  Width: 1600
  X: 100
  Y: 50
