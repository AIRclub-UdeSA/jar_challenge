Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.3
      Cell Size: 1
      Plane Cell Count: 12
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Mapa
      Enabled: true
      Alpha: 0.7
      Color Scheme: map
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Campo de verosimilitud
      Enabled: false
      Alpha: 0.5
      Color Scheme: costmap
      Topic:
        Value: /likelihood_map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Value: false
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Alpha: 0.8
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.3
      Show Names: true
      Value: false
    - Class: rviz_default_plugins/PoseArray
      Name: Partículas
      Enabled: true
      Color: 255; 25; 0
      Shape: Arrow (Flat)
      Arrow Length: 0.15
      Topic:
        Value: /particlecloud
        Depth: 5
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Camino odometría
      Enabled: true
      Color: 25; 255; 0
      Topic:
        Value: /camino_odom
        Depth: 5
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Camino corregido
      Enabled: true
      Color: 255; 0; 255
      Topic:
        Value: /camino_corregido
        Depth: 5
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Size (m): 0.02
      Style: Flat Squares
      Topic:
        Value: /scan
        Depth: 5
        Reliability Policy: Best Effort
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Scan cono evasor
      Enabled: false
      Color Transformer: FlatColor
      Color: 0; 200; 255
      Size (m): 0.04
      Style: Flat Squares
      Topic:
        Value: /scan_cono
        Depth: 5
        Reliability Policy: Best Effort
      Value: false
    - Class: rviz_default_plugins/LaserScan
      Name: Scan no mapeado
      Enabled: true
      Color Transformer: FlatColor
      Color: 255; 220; 0
      Size (m): 0.04
      Style: Flat Squares
      Topic:
        Value: /scan_no_mapeado
        Depth: 5
        Reliability Policy: Best Effort
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Scan rojo
      Enabled: true
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Size (m): 0.06
      Style: Flat Squares
      Topic:
        Value: /scan_rojo
        Depth: 5
        Reliability Policy: Best Effort
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Objetos no mapeados
      Enabled: true
      Topic:
        Value: /objetos_no_mapeados_markers
        Depth: 5
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Candidatos a víctima
      Enabled: true
      Topic:
        Value: /candidatos_markers
        Depth: 5
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Cámara
      Enabled: true
      Topic:
        Value: /cam_1/color/image_raw
        Depth: 5
        Reliability Policy: Best Effort
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Máscara de rojo
      Enabled: true
      Topic:
        Value: /mascara_rojo
        Depth: 5
        Reliability Policy: Reliable
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 10
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 90
      X: 1.5
      Y: -1
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
